{
  "manifest_version": 3,
  "name": "SocialLens",
  "description": "A local-first personal algorithm layer for tagging, filtering, and composing social feeds.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SocialLens"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://www.youtube.com/*",
        "https://news.ycombinator.com/*",
        "https://www.linkedin.com/*",
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/shared/rules.js",
        "src/content/platforms.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
